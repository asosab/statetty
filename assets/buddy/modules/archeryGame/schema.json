    { "key": "arrowLimit", "label": "Límite de flechas", "type": "object", "default": {}, "fields": [
      { "key": "countBeforeCooldown", "label": "Flechas antes del cooldown", "type": "number", "default": 6 },
      { "key": "cooldownMs", "label": "Cooldown (ms)", "type": "number", "default": 10000 }
    ] },
    { "key": "heartbeat", "label": "Latido de la mira", "type": "object", "default": {}, "fields": [
      { "key": "enabled", "label": "Activo", "type": "boolean", "default": true },
      { "key": "restAmplitudePx", "label": "Amplitud reposo (px)", "type": "number", "default": 1.5 },
      { "key": "maxAmplitudePx", "label": "Amplitud máxima (px)", "type": "number", "default": 14 }
    ] },
    { "key": "fatigue", "label": "Cansancio muscular", "type": "object", "default": {}, "fields": [
