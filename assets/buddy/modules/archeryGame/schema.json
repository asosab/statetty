      { "key": "promo", "label": "Promoción", "type": "object", "default": {}, "fields": [
        { "key": "enabled", "label": "Activo", "type": "boolean", "default": true },
        { "key": "whatsappNumber", "label": "Número WhatsApp", "type": "string", "default": "" }
      ] }
    ] },
    { "key": "testTrigger", "label": "Gatillo de prueba", "type": "object", "default": {}, "fields": [
      { "key": "clicksToTrigger", "label": "Clicks", "type": "number", "default": 3 },
      { "key": "windowMs", "label": "Ventana (ms)", "type": "number", "default": 500 }
